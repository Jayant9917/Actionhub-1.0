# Docker supplies empty public URL bases; browser uses gateway /api and /hooks.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_HOOKS_URL=
# On Vercel, set NEXT_PUBLIC_HOOKS_URL and ACTIONHUB_API_ORIGIN
# to https://api.actionhub.jayrana.in.
# Leave NEXT_PUBLIC_BACKEND_URL blank so browser API calls use this rewrite.
ACTIONHUB_API_ORIGIN=
