# Docker Desktop development. Copy to .env.docker and set JWT, encryption and Resend SMTP secrets.
WEB_PORT=8080
JWT_PASSWORD=
# PostgreSQL is internal. Email uses your verified Resend sending domain.

# 32 random bytes represented as 64 hex characters; keep stable and private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional one-workflow import of a GitHub webhook secret.
GITHUB_SECRETS=
GITHUB_SETUP_WORKFLOW_ID=

# Show and enable manual test events only in development.
APP_ENV=development

# Resend SMTP: never commit the real password or API key.
SMTP_ENDPOINT=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=notifications@your-verified-domain.example

# Scaling controls. Apply with the commands in docker/README.md; editing does not live-reload.
# Kafka partitions can only increase on an existing topic. Keep the group ID unchanged.
KAFKA_PARTITIONS=1
WORKER_REPLICAS=1
PROCESSOR_REPLICAS=1
# Concurrent partitions handled by each worker (1-256), not parallel jobs within one partition.
WORKER_CONCURRENCY=1
# Actions dispatched per cycle (1-1000), pause between cycles in milliseconds (100-60000).
PROCESSOR_BATCH_SIZE=50
PROCESSOR_POLL_INTERVAL_MS=2000
# Due schedules handled per processor cycle (1-500).
SCHEDULER_BATCH_SIZE=50
