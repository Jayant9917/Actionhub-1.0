PORT=3000
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/actionhub
# Set a private random value before starting; no built-in fallback.
JWT_PASSWORD=

# 32 random bytes represented as 64 hex characters; keep stable and private.
CREDENTIAL_ENCRYPTION_KEY=

# Optional one-workflow import of a GitHub webhook secret.
GITHUB_SECRETS=
GITHUB_SETUP_WORKFLOW_ID=

# Show and enable manual test events only in development.
APP_ENV=development

# Optional Google sign-in and Google Sheets OAuth. Same browser origin, no trailing path.
GOOGLE_OAUTH_PUBLIC_URL=http://localhost:8080
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Authentication throttles shared across API replicas through PostgreSQL.
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=30
# Login attempts per IP + normalized email pair.
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_SIGNUP_WINDOW_MS=3600000
AUTH_SIGNUP_IP_LIMIT=5
