# Public DNS hostname for EC2. Use a bare hostname without a scheme or path.
ACTIONHUB_API_HOST=api.actionhub.jayrana.in

# Use 32 random bytes as hex for each value. Keep the encryption key stable.
POSTGRES_PASSWORD=
JWT_PASSWORD=
CREDENTIAL_ENCRYPTION_KEY=

SMTP_ENDPOINT=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=notifications@actionhub.jayrana.in

# Optional. Set the URL to https://actionhub.jayrana.in after the custom
# frontend domain is active. Leave the Google settings blank to disable OAuth.
GOOGLE_OAUTH_PUBLIC_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
